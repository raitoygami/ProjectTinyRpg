<module name="">

	<bean name="Drop">
		<var name="item_id" type="int" comment="道具id"/>
		<var name="min" 	type="int" comment="最小值"/>
		<var name="max" 	type="int" comment="最大值"/>
		<var name="chance" 	type="int" comment="概率"/>
	</bean>
	
	<bean name="t_Drop" comment="道具">
		<var name="drop_id" type="int" 			comment="掉落ID"/>
		<var name="drops" 	type="list,Drop" 	comment="掉落列表"/>
	</bean>
	
	<table name="Data_Drop" value="t_Drop" input="掉落表@Item/道具系统表.xlsx" comment="掉落表"/>
	

</module>
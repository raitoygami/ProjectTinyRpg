<module name="">

	<enum name="EquipType" comment="装备类型">
		<var name="Weapon" 		value="0" alias="武器"/>
		<var name="Helmet" 		value="1" alias="头盔"/>
		<var name="Mask" 		value="2" alias="面具"/>
		<var name="Armor" 		value="3" alias="护甲"/>
		<var name="Boots" 		value="4" alias="鞋子"/>
	</enum>
	
	<bean name="t_Equip" parent="t_ItemBase" comment="装备">
		<var name="equipType" type="EquipType"/>
	</bean>
	
	<table name="Data_Equip" value="t_Equip" input="装备表@Item/装备系统表.xlsx" comment="装备"/>
	

</module>
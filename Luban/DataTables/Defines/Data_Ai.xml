<module name="">

	<bean name="AiParamsBase" comment="ai 参数">
		<var name="VisionRange" 			type="int" comment="警觉范围 / 视野范围（格子数，触发 Suspicious 的距离）"/>
		<var name="AggroRange" 				type="int" comment="进入攻击状态范围（从警觉转为 Hostile 的距离阈值）"/>
		<var name="ThreatTime" 				type="int" comment="警惕值（回合数，警觉状态持续时间，超时衰减）"/>
	</bean>
	
	<enum name="AiPattern" >
       <var name="Default" value="0" 		alias="默认"/>
       <var name="Summon" value="1" 	alias="召唤物1"/>
       <var name="Cautious" value="2" 	alias="谨慎"/>
       <var name="PackHunter" value="3" 	alias="群猎"/>
		<var name="Fleeing" value="4" 		alias="胆小"/>
    </enum>
	
	<bean name="AiStrategyParams" comment="AI策略专有参数 - 多态基类">
	</bean>
	
	<bean name="DefaultParams" parent="AiStrategyParams" comment="普通型" alias="普通型">
		<var name="ChaseTiredDuration" 	type="int" 		comment= "追击疲惫回合"/>
    </bean>
	
	<bean name="Summon1Params" parent="AiStrategyParams" comment="召唤物1" alias="召唤物1">
		<var name="FollowDistance" type="int" comment="跟随主人距离"/>
    </bean>
	
	<bean name="t_AI" comment="AI类">
		<var name="id" 				type="int" comment="id"	/>
		<var name="aiParamsBase"	type="AiParamsBase"		/>
		<var name="aiPattern" 		type="AiPattern"		/>
		<var name="strategyParams" 	type="AiStrategyParams"	/>
	</bean>
	
	<table name="Data_AI" value="t_AI" input="AI表@AI/AI表.xlsx" comment="AI表"/>
	

</module>